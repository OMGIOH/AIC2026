{"type": "verse", "doc_id": "buyi_epic_12204413", "page": 90, "verse_no": 2, "layout": "interlinear", "yi": {"text": "长藤又结果，", "line_no": 4, "char_start": 10, "char_end": 16}, "zhi": {"text": "成　藤　又　成　个", "line_no": 4, "char_start": 0, "char_end": 9}, "flags": [], "cross_blocks": null, "canon_version": "v1.0-ocr", "engine": "vision-python-v1", "yin": {"text": "盆　勾　也　盆　吞", "line_no": 3, "char_start": 0, "char_end": 9}, "yin_line_consumed": true}
{"type": "verse", "doc_id": "buyi_epic_12204413", "page": 90, "verse_no": 3, "layout": "interlinear", "yi": {"text": "一天天长大，", "line_no": 6, "char_start": 8, "char_end": 14}, "zhi": {"text": "日　和　日　就", "line_no": 6, "char_start": 0, "char_end": 7}, "flags": [], "cross_blocks": null, "canon_version": "v1.0-ocr", "engine": "vision-python-v1", "yin": {"text": "添香吉", "line_no": 5, "char_start": 0, "char_end": 3}, "yin_line_consumed": true}
{"type": "verse", "doc_id": "buyi_epic_12204413", "page": 90, "verse_no": 4, "layout": "interlinear", "yi": {"text": "藤粗叶青绿，", "line_no": 8, "char_start": 10, "char_end": 16}, "zhi": {"text": "藤　去　上面　青绿", "line_no": 8, "char_start": 0, "char_end": 9}, "flags": [], "cross_blocks": null, "canon_version": "v1.0-ocr", "engine": "vision-python-v1", "yin": {"text": "勾　丕　更　薅夭　嗯嶟", "line_no": 7, "char_start": 0, "char_end": 11}, "yin_line_consumed": true}
{"type": "verse", "doc_id": "buyi_epic_12204413", "page": 90, "verse_no": 5, "layout": "interlinear", "yi": {"text": "牵上马桑蓬。", "line_no": 10, "char_start": 9, "char_end": 15}, "zhi": {"text": "牵　马桑树　葱蓬", "line_no": 10, "char_start": 0, "char_end": 8}, "flags": [], "cross_blocks": null, "canon_version": "v1.0-ocr", "engine": "vision-python-v1", "yin": {"text": "也　棵操　丰隆　南转", "line_no": 9, "char_start": 0, "char_end": 10}, "yin_line_consumed": true}
