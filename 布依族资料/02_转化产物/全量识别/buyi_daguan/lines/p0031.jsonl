{"type": "line", "doc_id": "buyi_daguan", "page": 31, "line_no": 5, "text": "然就成“百濮”了。", "bbox_px": {"x": 137, "y": 445, "w": 318, "h": 55}, "n_blocks": 1, "min_conf": 0.5, "blocks": [{"text": "然就成“百濮”了。", "conf": 0.5, "bbox_px": {"x": 137, "y": 445, "w": 318, "h": 55}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
