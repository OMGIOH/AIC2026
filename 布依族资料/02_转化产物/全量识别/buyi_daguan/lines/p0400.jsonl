{"type": "line", "doc_id": "buyi_daguan", "page": 400, "line_no": 12, "text": "又拜七许且七君，", "bbox_px": {"x": 422, "y": 917, "w": 306, "h": 49}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "又拜七许且七君，", "conf": 1.0, "bbox_px": {"x": 422, "y": 917, "w": 306, "h": 49}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
{"type": "line", "doc_id": "buyi_daguan", "page": 400, "line_no": 13, "text": "米魂父母说原因。", "bbox_px": {"x": 422, "y": 982, "w": 314, "h": 48}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "米魂父母说原因。", "conf": 1.0, "bbox_px": {"x": 422, "y": 982, "w": 314, "h": 48}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
