{"type": "line", "doc_id": "buyi_daguan", "page": 253, "line_no": 15, "text": "组织者来分，可分为官方组织举办和民间举办两类。", "bbox_px": {"x": 129, "y": 1094, "w": 905, "h": 49}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "组织者来分，可分为官方组织举办和民间举办两类。", "conf": 1.0, "bbox_px": {"x": 129, "y": 1094, "w": 905, "h": 49}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
