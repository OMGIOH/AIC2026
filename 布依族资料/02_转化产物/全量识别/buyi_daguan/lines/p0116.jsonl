{"type": "line", "doc_id": "buyi_daguan", "page": 116, "line_no": 17, "text": "（三）在社会历史观中发扬儒家的进取精神", "bbox_px": {"x": 173, "y": 1255, "w": 776, "h": 45}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "（三）在社会历史观中发扬儒家的进取精神", "conf": 1.0, "bbox_px": {"x": 173, "y": 1255, "w": 776, "h": 45}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
