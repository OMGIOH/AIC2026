{"type": "line", "doc_id": "buyi_daguan", "page": 67, "line_no": 30, "text": "明洪武年间的“调北征南”和“调北填南”。抗日战争期间和中华人民共和国成立后，又陆", "bbox_px": {"x": 133, "y": 2060, "w": 1548, "h": 60}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "明洪武年间的“调北征南”和“调北填南”。抗日战争期间和中华人民共和国成立后，又陆", "conf": 1.0, "bbox_px": {"x": 133, "y": 2060, "w": 1548, "h": 60}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
