{"type": "line", "doc_id": "buyi_daguan", "page": 366, "line_no": 26, "text": "著述方面有《二南近说》、《仁本事韵》、《喇嘛纪闻》等传世。", "bbox_px": {"x": 88, "y": 1819, "w": 1033, "h": 56}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "著述方面有《二南近说》、《仁本事韵》、《喇嘛纪闻》等传世。", "conf": 1.0, "bbox_px": {"x": 88, "y": 1819, "w": 1033, "h": 56}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
