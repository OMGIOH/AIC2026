{"type": "line", "doc_id": "buyi_daguan", "page": 172, "line_no": 29, "text": "偶尔小两口发生口角，听到家人或外人进门，也要马上转怒为喜，破涕力笑，不让他", "bbox_px": {"x": 189, "y": 1959, "w": 1459, "h": 53}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "偶尔小两口发生口角，听到家人或外人进门，也要马上转怒为喜，破涕力笑，不让他", "conf": 1.0, "bbox_px": {"x": 189, "y": 1959, "w": 1459, "h": 53}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
{"type": "line", "doc_id": "buyi_daguan", "page": 172, "line_no": 30, "text": "人觉察痕迹。", "bbox_px": {"x": 108, "y": 2027, "w": 230, "h": 50}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "人觉察痕迹。", "conf": 1.0, "bbox_px": {"x": 108, "y": 2027, "w": 230, "h": 50}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
