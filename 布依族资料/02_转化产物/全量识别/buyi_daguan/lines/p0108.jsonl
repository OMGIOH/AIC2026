{"type": "line", "doc_id": "buyi_daguan", "page": 108, "line_no": 23, "text": "垮了三整天，", "bbox_px": {"x": 414, "y": 1247, "w": 229, "h": 48}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "垮了三整天，", "conf": 1.0, "bbox_px": {"x": 414, "y": 1247, "w": 229, "h": 48}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
