{"type": "line", "doc_id": "buyi_daguan", "page": 122, "line_no": 29, "text": "（二）布依族史诗《柔番沃番钱》的王权神授思想", "bbox_px": {"x": 157, "y": 2088, "w": 868, "h": 44}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "（二）布依族史诗《柔番沃番钱》的王权神授思想", "conf": 1.0, "bbox_px": {"x": 157, "y": 2088, "w": 868, "h": 44}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
