{"type": "line", "doc_id": "buyi_daguan", "page": 23, "line_no": 18, "text": "人民政府办公厅出台了《关于进一步繁荣发展少数民族文化事业的实施意", "bbox_px": {"x": 133, "y": 1810, "w": 1548, "h": 53}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "人民政府办公厅出台了《关于进一步繁荣发展少数民族文化事业的实施意", "conf": 1.0, "bbox_px": {"x": 133, "y": 1810, "w": 1548, "h": 53}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
