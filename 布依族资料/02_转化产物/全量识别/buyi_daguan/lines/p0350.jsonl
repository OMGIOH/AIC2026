{"type": "line", "doc_id": "buyi_daguan", "page": 350, "line_no": 25, "text": "上注重人物形象的塑造和语言的流畅生动。早期的民间长诗反映民族生活的内容比较", "bbox_px": {"x": 88, "y": 1690, "w": 1544, "h": 56}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "上注重人物形象的塑造和语言的流畅生动。早期的民间长诗反映民族生活的内容比较", "conf": 1.0, "bbox_px": {"x": 88, "y": 1690, "w": 1544, "h": 56}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
