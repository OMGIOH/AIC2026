{"type": "line", "doc_id": "buyi_daguan", "page": 350, "line_no": 27, "text": "会生活的内容。", "bbox_px": {"x": 88, "y": 1820, "w": 270, "h": 58}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "会生活的内容。", "conf": 1.0, "bbox_px": {"x": 88, "y": 1820, "w": 270, "h": 58}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
