{"type": "line", "doc_id": "buyi_daguan", "page": 500, "line_no": 25, "text": "’、“九十九道阴河”之说。平畴间一条弯曲小道，由北向南蜿蜒翻越", "bbox_px": {"x": 486, "y": 2000, "w": 1158, "h": 52}, "n_blocks": 1, "min_conf": 0.5, "blocks": [{"text": "’、“九十九道阴河”之说。平畴间一条弯曲小道，由北向南蜿蜒翻越", "conf": 0.5, "bbox_px": {"x": 486, "y": 2000, "w": 1158, "h": 52}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
