{"type": "line", "doc_id": "buyi_daguan", "page": 435, "line_no": 18, "text": "二撒南，子子孙孙做高官。", "bbox_px": {"x": 462, "y": 1271, "w": 458, "h": 53}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "二撒南，子子孙孙做高官。", "conf": 1.0, "bbox_px": {"x": 462, "y": 1271, "w": 458, "h": 53}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
