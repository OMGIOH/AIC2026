{"type": "line", "doc_id": "buyi_daguan", "page": 481, "line_no": 23, "text": "代文化遗存出土于表土层中。旧石器时代文化遗存出土于灰烬层和黄土层中。", "bbox_px": {"x": 133, "y": 1593, "w": 1371, "h": 53}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "代文化遗存出土于表土层中。旧石器时代文化遗存出土于灰烬层和黄土层中。", "conf": 1.0, "bbox_px": {"x": 133, "y": 1593, "w": 1371, "h": 53}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
