{"type": "line", "doc_id": "buyi_daguan", "page": 126, "line_no": 5, "text": "三、近现代“乡规民约碑”：铭刻着布依族追求社会和谐的理想", "bbox_px": {"x": 144, "y": 467, "w": 1070, "h": 73}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "三、近现代“乡规民约碑”：铭刻着布依族追求社会和谐的理想", "conf": 1.0, "bbox_px": {"x": 144, "y": 467, "w": 1070, "h": 73}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
