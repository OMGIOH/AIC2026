{"type": "line", "doc_id": "buyi_daguan", "page": 435, "line_no": 5, "text": "主家梁上我安排。", "bbox_px": {"x": 466, "y": 430, "w": 306, "h": 49}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "主家梁上我安排。", "conf": 1.0, "bbox_px": {"x": 466, "y": 430, "w": 306, "h": 49}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
