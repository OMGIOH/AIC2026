{"type": "line", "doc_id": "buyi_daguan", "page": 98, "line_no": 15, "text": "求恢复推行布依文，但应根据布依语实际情况重新修订方案。建议以布依族集中、语音", "bbox_px": {"x": 60, "y": 1235, "w": 1548, "h": 48}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "求恢复推行布依文，但应根据布依语实际情况重新修订方案。建议以布依族集中、语音", "conf": 1.0, "bbox_px": {"x": 60, "y": 1235, "w": 1548, "h": 48}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
