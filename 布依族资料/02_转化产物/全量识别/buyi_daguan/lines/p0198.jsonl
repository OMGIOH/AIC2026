{"type": "line", "doc_id": "buyi_daguan", "page": 198, "line_no": 19, "text": "初展的苔茶，拿回去加工。", "bbox_px": {"x": 1174, "y": 1380, "w": 490, "h": 48}, "n_blocks": 1, "min_conf": 0.5, "blocks": [{"text": "初展的苔茶，拿回去加工。", "conf": 0.5, "bbox_px": {"x": 1174, "y": 1380, "w": 490, "h": 48}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
