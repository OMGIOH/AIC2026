{"type": "line", "doc_id": "buyi_daguan", "page": 228, "line_no": 32, "text": "挑选一些年轻力壮的小伙子去外家挑礼物，邀请外家一同前来吃“月米酒”。外家和亲戚", "bbox_px": {"x": 125, "y": 2229, "w": 1540, "h": 56}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "挑选一些年轻力壮的小伙子去外家挑礼物，邀请外家一同前来吃“月米酒”。外家和亲戚", "conf": 1.0, "bbox_px": {"x": 125, "y": 2229, "w": 1540, "h": 56}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
