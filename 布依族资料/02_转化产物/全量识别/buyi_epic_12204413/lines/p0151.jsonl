{"type": "verse", "doc_id": "buyi_epic_12204413", "page": 151, "verse_no": 1, "layout": "interlinear", "yi": {"text": "出去不归家，", "line_no": 2, "char_start": 10, "char_end": 16}, "zhi": {"text": "出　坡　不　来　家", "line_no": 2, "char_start": 0, "char_end": 9}, "flags": [], "cross_blocks": null, "canon_version": "v1.0-ocr", "engine": "vision-python-v1", "yin": {"text": "丕　罢　否　妈　然", "line_no": 1, "char_start": 0, "char_end": 9}, "yin_line_consumed": true}
{"type": "verse", "doc_id": "buyi_epic_12204413", "page": 151, "verse_no": 2, "layout": "interlinear", "yi": {"text": "世间不见这样做，", "line_no": 4, "char_start": 11, "char_end": 19}, "zhi": {"text": "地方　不　见　做　这", "line_no": 4, "char_start": 0, "char_end": 10}, "flags": [], "cross_blocks": null, "canon_version": "v1.0-ocr", "engine": "vision-python-v1", "yin": {"text": "庞　否　颠　故　你", "line_no": 3, "char_start": 0, "char_end": 9}, "yin_line_consumed": true}
{"type": "verse", "doc_id": "buyi_epic_12204413", "page": 151, "verse_no": 3, "layout": "interlinear", "yi": {"text": "哥娶妹为妻。", "line_no": 6, "char_start": 9, "char_end": 15}, "zhi": {"text": "哥　要　妹　成家", "line_no": 6, "char_start": 0, "char_end": 8}, "flags": [], "cross_blocks": null, "canon_version": "v1.0-ocr", "engine": "vision-python-v1", "yin": {"text": "皮　欧农　故然", "line_no": 5, "char_start": 0, "char_end": 7}, "yin_line_consumed": true}
{"type": "verse", "doc_id": "buyi_epic_12204413", "page": 151, "verse_no": 4, "layout": "interlinear", "yi": {"text": "去了对场十三天，", "line_no": 8, "char_start": 10, "char_end": 18}, "zhi": {"text": "去　得　对场　十三", "line_no": 8, "char_start": 0, "char_end": 9}, "flags": [], "cross_blocks": null, "canon_version": "v1.0-ocr", "engine": "vision-python-v1", "yin": {"text": "丕　合　信占", "line_no": 7, "char_start": 0, "char_end": 6}, "yin_line_consumed": true}
