{"type": "line", "doc_id": "buyi_daguan", "page": 373, "line_no": 10, "text": "第三节艺术", "bbox_px": {"x": 712, "y": 853, "w": 370, "h": 60}, "n_blocks": 1, "min_conf": 0.5, "blocks": [{"text": "第三节艺术", "conf": 0.5, "bbox_px": {"x": 712, "y": 853, "w": 370, "h": 60}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
