{"type": "line", "doc_id": "buyi_daguan", "page": 312, "line_no": 9, "text": "的牂柯作一个较大的国家，位于南夷群国之中。", "bbox_px": {"x": 109, "y": 712, "w": 864, "h": 56}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "的牂柯作一个较大的国家，位于南夷群国之中。", "conf": 1.0, "bbox_px": {"x": 109, "y": 712, "w": 864, "h": 56}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
