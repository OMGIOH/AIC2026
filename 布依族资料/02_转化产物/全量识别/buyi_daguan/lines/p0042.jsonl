{"type": "line", "doc_id": "buyi_daguan", "page": 42, "line_no": 16, "text": "洞中还发现灰烬层，其中有各色灰烬、炭屑、烧骨与烧石，是我国华南古人类用火遗", "bbox_px": {"x": 169, "y": 1167, "w": 1459, "h": 48}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "洞中还发现灰烬层，其中有各色灰烬、炭屑、烧骨与烧石，是我国华南古人类用火遗", "conf": 1.0, "bbox_px": {"x": 169, "y": 1167, "w": 1459, "h": 48}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
