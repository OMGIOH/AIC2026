{"type": "line", "doc_id": "buyi_daguan", "page": 46, "line_no": 33, "text": "关”（we:n'geu\"kon’），意即“古时的歌”。", "bbox_px": {"x": 92, "y": 2281, "w": 691, "h": 57}, "n_blocks": 1, "min_conf": 0.3, "blocks": [{"text": "关”（we:n'geu\"kon’），意即“古时的歌”。", "conf": 0.3, "bbox_px": {"x": 92, "y": 2281, "w": 691, "h": 57}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
