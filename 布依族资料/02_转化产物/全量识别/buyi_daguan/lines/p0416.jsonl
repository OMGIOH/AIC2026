{"type": "line", "doc_id": "buyi_daguan", "page": 416, "line_no": 22, "text": "翻过一百二十座大坡，", "bbox_px": {"x": 414, "y": 1569, "w": 386, "h": 48}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "翻过一百二十座大坡，", "conf": 1.0, "bbox_px": {"x": 414, "y": 1569, "w": 386, "h": 48}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
