{"type": "line", "doc_id": "buyi_daguan", "page": 122, "line_no": 13, "text": "一百二十个婴儿作租，", "bbox_px": {"x": 398, "y": 1054, "w": 394, "h": 48}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "一百二十个婴儿作租，", "conf": 1.0, "bbox_px": {"x": 398, "y": 1054, "w": 394, "h": 48}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
