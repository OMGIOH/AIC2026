{"type": "line", "doc_id": "buyi_daguan", "page": 121, "line_no": 24, "text": "及两位王子争夺王位的故事。", "bbox_px": {"x": 145, "y": 1621, "w": 515, "h": 49}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "及两位王子争夺王位的故事。", "conf": 1.0, "bbox_px": {"x": 145, "y": 1621, "w": 515, "h": 49}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
