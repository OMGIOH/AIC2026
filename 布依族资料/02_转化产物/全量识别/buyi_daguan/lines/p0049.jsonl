{"type": "line", "doc_id": "buyi_daguan", "page": 49, "line_no": 14, "text": "吉贝者，树名也，其华成时如", "bbox_px": {"x": 125, "y": 1018, "w": 490, "h": 52}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "吉贝者，树名也，其华成时如", "conf": 1.0, "bbox_px": {"x": 125, "y": 1018, "w": 490, "h": 52}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
{"type": "line", "doc_id": "buyi_daguan", "page": 49, "line_no": 15, "text": "鹅毛，抽其絮纺之以作布，布", "bbox_px": {"x": 121, "y": 1082, "w": 494, "h": 53}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "鹅毛，抽其絮纺之以作布，布", "conf": 1.0, "bbox_px": {"x": 121, "y": 1082, "w": 494, "h": 53}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
{"type": "line", "doc_id": "buyi_daguan", "page": 49, "line_no": 16, "text": "与丝不。亦染成五色，织", "bbox_px": {"x": 125, "y": 1151, "w": 486, "h": 48}, "n_blocks": 1, "min_conf": 0.5, "blocks": [{"text": "与丝不。亦染成五色，织", "conf": 0.5, "bbox_px": {"x": 125, "y": 1151, "w": 486, "h": 48}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
