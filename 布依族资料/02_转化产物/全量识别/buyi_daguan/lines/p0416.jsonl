{"type": "line", "doc_id": "buyi_daguan", "page": 416, "line_no": 18, "text": "侍者立即递一张帕子给“仙人”。“仙人”抹过汗后又唱道：", "bbox_px": {"x": 165, "y": 1300, "w": 1021, "h": 56}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "侍者立即递一张帕子给“仙人”。“仙人”抹过汗后又唱道：", "conf": 1.0, "bbox_px": {"x": 165, "y": 1300, "w": 1021, "h": 56}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
{"type": "line", "doc_id": "buyi_daguan", "page": 416, "line_no": 19, "text": "拿茶来漱口，", "bbox_px": {"x": 410, "y": 1372, "w": 229, "h": 52}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "拿茶来漱口，", "conf": 1.0, "bbox_px": {"x": 410, "y": 1372, "w": 229, "h": 52}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
{"type": "line", "doc_id": "buyi_daguan", "page": 416, "line_no": 20, "text": "拿酒来解渴。", "bbox_px": {"x": 414, "y": 1432, "w": 233, "h": 57}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "拿酒来解渴。", "conf": 1.0, "bbox_px": {"x": 414, "y": 1432, "w": 233, "h": 57}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
