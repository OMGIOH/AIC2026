{"type": "line", "doc_id": "buyi_daguan", "page": 176, "line_no": 3, "text": "二、社会交往中表现出的社会道德", "bbox_px": {"x": 189, "y": 346, "w": 591, "h": 52}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "二、社会交往中表现出的社会道德", "conf": 1.0, "bbox_px": {"x": 189, "y": 346, "w": 591, "h": 52}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
