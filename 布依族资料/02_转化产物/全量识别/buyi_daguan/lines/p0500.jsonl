{"type": "line", "doc_id": "buyi_daguan", "page": 500, "line_no": 3, "text": "刻，字迹尚可辨认。碑文中反应了布依族的风水信仰，并以此为由，“栽蓄树木”，禁止砍", "bbox_px": {"x": 101, "y": 310, "w": 1552, "h": 60}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "刻，字迹尚可辨认。碑文中反应了布依族的风水信仰，并以此为由，“栽蓄树木”，禁止砍", "conf": 1.0, "bbox_px": {"x": 101, "y": 310, "w": 1552, "h": 60}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
{"type": "line", "doc_id": "buyi_daguan", "page": 500, "line_no": 4, "text": "伐坟山林木，对保护自然生态具有积极意义。", "bbox_px": {"x": 101, "y": 378, "w": 784, "h": 57}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "伐坟山林木，对保护自然生态具有积极意义。", "conf": 1.0, "bbox_px": {"x": 101, "y": 378, "w": 784, "h": 57}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
