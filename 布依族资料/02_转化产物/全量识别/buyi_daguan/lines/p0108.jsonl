{"type": "line", "doc_id": "buyi_daguan", "page": 108, "line_no": 15, "text": "“翁杰”（von\"tge”）站在云天上，", "bbox_px": {"x": 410, "y": 982, "w": 571, "h": 56}, "n_blocks": 1, "min_conf": 0.3, "blocks": [{"text": "“翁杰”（von\"tge”）站在云天上，", "conf": 0.3, "bbox_px": {"x": 410, "y": 982, "w": 571, "h": 56}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
{"type": "line", "doc_id": "buyi_daguan", "page": 108, "line_no": 16, "text": "五天长毛衣。", "bbox_px": {"x": 1045, "y": 989, "w": 229, "h": 45}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "五天长毛衣。", "conf": 1.0, "bbox_px": {"x": 1045, "y": 989, "w": 229, "h": 45}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
{"type": "line", "doc_id": "buyi_daguan", "page": 108, "line_no": 17, "text": "左脚踩岩山，右脚踩土山。", "bbox_px": {"x": 414, "y": 1054, "w": 494, "h": 48}, "n_blocks": 1, "min_conf": 0.5, "blocks": [{"text": "左脚踩岩山，右脚踩土山。", "conf": 0.5, "bbox_px": {"x": 414, "y": 1054, "w": 494, "h": 48}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
