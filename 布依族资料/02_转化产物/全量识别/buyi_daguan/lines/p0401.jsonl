{"type": "line", "doc_id": "buyi_daguan", "page": 401, "line_no": 6, "text": "早在婆王墙脚躲，", "bbox_px": {"x": 434, "y": 491, "w": 314, "h": 52}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "早在婆王墙脚躲，", "conf": 1.0, "bbox_px": {"x": 434, "y": 491, "w": 314, "h": 52}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
{"type": "line", "doc_id": "buyi_daguan", "page": 401, "line_no": 7, "text": "晚在婆王仓边眠。", "bbox_px": {"x": 438, "y": 555, "w": 311, "h": 53}, "n_blocks": 1, "min_conf": 0.5, "blocks": [{"text": "晚在婆王仓边眠。", "conf": 0.5, "bbox_px": {"x": 438, "y": 555, "w": 311, "h": 53}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
{"type": "line", "doc_id": "buyi_daguan", "page": 401, "line_no": 8, "text": "婆王还醒它不动，", "bbox_px": {"x": 438, "y": 628, "w": 306, "h": 48}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "婆王还醒它不动，", "conf": 1.0, "bbox_px": {"x": 438, "y": 628, "w": 306, "h": 48}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
{"type": "line", "doc_id": "buyi_daguan", "page": 401, "line_no": 9, "text": "婆王睡熟它才啃。", "bbox_px": {"x": 438, "y": 692, "w": 310, "h": 44}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "婆王睡熟它才啃。", "conf": 1.0, "bbox_px": {"x": 438, "y": 692, "w": 310, "h": 44}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
{"type": "line", "doc_id": "buyi_daguan", "page": 401, "line_no": 10, "text": "火为眼，铁为牙，", "bbox_px": {"x": 438, "y": 755, "w": 290, "h": 52}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "火为眼，铁为牙，", "conf": 1.0, "bbox_px": {"x": 438, "y": 755, "w": 290, "h": 52}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
