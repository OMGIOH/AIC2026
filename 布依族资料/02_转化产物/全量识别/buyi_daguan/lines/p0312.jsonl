{"type": "line", "doc_id": "buyi_daguan", "page": 312, "line_no": 11, "text": "枝、关岭、晴隆、盘县、织金、镇宁、普安、安顺、紫云、兴仁、安龙、贞丰和云南的富源等地。", "bbox_px": {"x": 109, "y": 845, "w": 1512, "h": 52}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "枝、关岭、晴隆、盘县、织金、镇宁、普安、安顺、紫云、兴仁、安龙、贞丰和云南的富源等地。", "conf": 1.0, "bbox_px": {"x": 109, "y": 845, "w": 1512, "h": 52}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
