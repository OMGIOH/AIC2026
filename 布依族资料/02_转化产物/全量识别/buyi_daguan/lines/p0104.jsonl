{"type": "line", "doc_id": "buyi_daguan", "page": 104, "line_no": 18, "text": "个个都埋怨⋯⋯", "bbox_px": {"x": 382, "y": 994, "w": 285, "h": 44}, "n_blocks": 1, "min_conf": 0.3, "blocks": [{"text": "个个都埋怨⋯⋯", "conf": 0.3, "bbox_px": {"x": 382, "y": 994, "w": 285, "h": 44}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
{"type": "line", "doc_id": "buyi_daguan", "page": 104, "line_no": 19, "text": "挖来神仙土，", "bbox_px": {"x": 848, "y": 988, "w": 234, "h": 55}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "挖来神仙土，", "conf": 1.0, "bbox_px": {"x": 848, "y": 988, "w": 234, "h": 55}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
{"type": "line", "doc_id": "buyi_daguan", "page": 104, "line_no": 20, "text": "你一言我一语，", "bbox_px": {"x": 377, "y": 1060, "w": 270, "h": 53}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "你一言我一语，", "conf": 1.0, "bbox_px": {"x": 377, "y": 1060, "w": 270, "h": 53}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
