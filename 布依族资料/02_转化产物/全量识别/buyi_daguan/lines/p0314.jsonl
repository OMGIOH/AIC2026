{"type": "line", "doc_id": "buyi_daguan", "page": 314, "line_no": 24, "text": "人民在定期市场上出售农产品、土特产、家庭手工业的编织品和纺织品以及牛马、猪羊等", "bbox_px": {"x": 117, "y": 1686, "w": 1548, "h": 56}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "人民在定期市场上出售农产品、土特产、家庭手工业的编织品和纺织品以及牛马、猪羊等", "conf": 1.0, "bbox_px": {"x": 117, "y": 1686, "w": 1548, "h": 56}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
