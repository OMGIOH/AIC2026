{"type": "verse", "doc_id": "buyi_epic_12204413", "page": 39, "verse_no": 2, "layout": "interlinear", "yi": {"text": "石头熔成片，", "line_no": 4, "char_start": 11, "char_end": 17}, "zhi": {"text": "石头　熔FT成　碎块", "line_no": 4, "char_start": 0, "char_end": 10}, "flags": [], "cross_blocks": null, "canon_version": "v1.0-ocr", "engine": "vision-python-v1", "yin": {"text": "溶　盆　烂办", "line_no": 3, "char_start": 0, "char_end": 6}, "yin_line_consumed": true}
{"type": "verse", "doc_id": "buyi_epic_12204413", "page": 39, "verse_no": 3, "layout": "interlinear", "yi": {"text": "人出门就死，", "line_no": 6, "char_start": 11, "char_end": 17}, "zhi": {"text": "人　去　天羽　死　多", "line_no": 6, "char_start": 0, "char_end": 10}, "flags": [], "cross_blocks": null, "canon_version": "v1.0-ocr", "engine": "vision-python-v1", "yin": {"text": "卜　丕　殿　歹　来", "line_no": 5, "char_start": 0, "char_end": 9}, "yin_line_consumed": true}
{"type": "verse", "doc_id": "buyi_epic_12204413", "page": 39, "verse_no": 4, "layout": "interlinear", "yi": {"text": "人在家恐慌。", "line_no": 8, "char_start": 12, "char_end": 18}, "zhi": {"text": "人　在人　1家　恐慌大", "line_no": 8, "char_start": 0, "char_end": 11}, "flags": [], "cross_blocks": null, "canon_version": "v1.0-ocr", "engine": "vision-python-v1", "yin": {"text": "卜　以　然　休算", "line_no": 7, "char_start": 0, "char_end": 8}, "yin_line_consumed": true}
{"type": "verse", "doc_id": "buyi_epic_12204413", "page": 39, "verse_no": 5, "layout": "interlinear", "yi": {"text": "天下人来商量，", "line_no": 10, "char_start": 11, "char_end": 18}, "zhi": {"text": "全　地方　来　商量六", "line_no": 10, "char_start": 0, "char_end": 10}, "flags": [], "cross_blocks": null, "canon_version": "v1.0-ocr", "engine": "vision-python-v1", "yin": {"text": "了　庞斗　同算", "line_no": 9, "char_start": 0, "char_end": 7}, "yin_line_consumed": true}
