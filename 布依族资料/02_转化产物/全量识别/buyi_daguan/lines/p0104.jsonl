{"type": "line", "doc_id": "buyi_daguan", "page": 104, "line_no": 14, "text": "世间无夜晚。", "bbox_px": {"x": 378, "y": 865, "w": 229, "h": 49}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "世间无夜晚。", "conf": 1.0, "bbox_px": {"x": 378, "y": 865, "w": 229, "h": 49}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
{"type": "line", "doc_id": "buyi_daguan", "page": 104, "line_no": 15, "text": "布杰祖先最聪明，", "bbox_px": {"x": 848, "y": 861, "w": 314, "h": 52}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "布杰祖先最聪明，", "conf": 1.0, "bbox_px": {"x": 848, "y": 861, "w": 314, "h": 52}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
