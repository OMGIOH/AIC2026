{"type": "line", "doc_id": "buyi_daguan", "page": 68, "line_no": 11, "text": "折、出纳、工资、奖金等；⑦有关军事、公安及政法等方面的语词，如部队、解放军、公安局、", "bbox_px": {"x": 72, "y": 853, "w": 1552, "h": 56}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "折、出纳、工资、奖金等；⑦有关军事、公安及政法等方面的语词，如部队、解放军、公安局、", "conf": 1.0, "bbox_px": {"x": 72, "y": 853, "w": 1552, "h": 56}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
