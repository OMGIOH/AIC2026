{"type": "line", "doc_id": "buyi_daguan", "page": 103, "line_no": 28, "text": "四面八方皆沉沉。", "bbox_px": {"x": 454, "y": 1878, "w": 310, "h": 53}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "四面八方皆沉沉。", "conf": 1.0, "bbox_px": {"x": 454, "y": 1878, "w": 310, "h": 53}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
{"type": "line", "doc_id": "buyi_daguan", "page": 103, "line_no": 29, "text": "他把浊气捏在右手心。", "bbox_px": {"x": 921, "y": 1879, "w": 394, "h": 48}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "他把浊气捏在右手心。", "conf": 1.0, "bbox_px": {"x": 921, "y": 1879, "w": 394, "h": 48}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
