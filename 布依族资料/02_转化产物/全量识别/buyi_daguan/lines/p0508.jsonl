{"type": "line", "doc_id": "buyi_daguan", "page": 508, "line_no": 11, "text": "贵定音寨 坐落在贵定县盘江镇南面，依山傍水，整个寨坐东向西，背靠郁郁葱葱的", "bbox_px": {"x": 197, "y": 849, "w": 1459, "h": 52}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "贵定音寨 坐落在贵定县盘江镇南面，依山傍水，整个寨坐东向西，背靠郁郁葱葱的", "conf": 1.0, "bbox_px": {"x": 197, "y": 849, "w": 1459, "h": 52}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
