{"type": "line", "doc_id": "buyi_daguan", "page": 313, "line_no": 35, "text": "界的联系和交流，推动了社会、经济和文化的发展。", "bbox_px": {"x": 121, "y": 2301, "w": 884, "h": 53}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "界的联系和交流，推动了社会、经济和文化的发展。", "conf": 1.0, "bbox_px": {"x": 121, "y": 2301, "w": 884, "h": 53}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
