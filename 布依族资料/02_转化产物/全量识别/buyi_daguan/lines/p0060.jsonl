{"type": "line", "doc_id": "buyi_daguan", "page": 60, "line_no": 29, "text": "高崇”、“贵杂玛母”、“贵独粑”、“贵独绒”等十数种。刺绣花纹有人物、花卉、乌兽及其他", "bbox_px": {"x": 76, "y": 1951, "w": 1540, "h": 57}, "n_blocks": 1, "min_conf": 0.5, "blocks": [{"text": "高崇”、“贵杂玛母”、“贵独粑”、“贵独绒”等十数种。刺绣花纹有人物、花卉、乌兽及其他", "conf": 0.5, "bbox_px": {"x": 76, "y": 1951, "w": 1540, "h": 57}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
