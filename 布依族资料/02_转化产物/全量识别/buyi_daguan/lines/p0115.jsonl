{"type": "line", "doc_id": "buyi_daguan", "page": 115, "line_no": 22, "text": "《尔雅》，堪称我国训诂学鼻祖。盛览，字长通，“牂柯名士”，是司马相如门人，善写辞赋，", "bbox_px": {"x": 117, "y": 1553, "w": 1548, "h": 52}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "《尔雅》，堪称我国训诂学鼻祖。盛览，字长通，“牂柯名士”，是司马相如门人，善写辞赋，", "conf": 1.0, "bbox_px": {"x": 117, "y": 1553, "w": 1548, "h": 52}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
