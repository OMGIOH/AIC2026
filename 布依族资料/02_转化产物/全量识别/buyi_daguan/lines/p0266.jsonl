{"type": "line", "doc_id": "buyi_daguan", "page": 266, "line_no": 9, "text": "四、布依族岁时节日习俗的社会功能", "bbox_px": {"x": 189, "y": 712, "w": 631, "h": 52}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "四、布依族岁时节日习俗的社会功能", "conf": 1.0, "bbox_px": {"x": 189, "y": 712, "w": 631, "h": 52}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
