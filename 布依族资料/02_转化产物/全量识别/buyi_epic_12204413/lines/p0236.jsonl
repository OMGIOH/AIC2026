{"type": "verse", "doc_id": "buyi_epic_12204413", "page": 236, "verse_no": 3, "layout": "xuanyi", "yi": {"text": "牛在圈里喂奶，", "line_no": 5, "char_start": 11, "char_end": 18}, "zhi": {"text": "奶　儿子水牛下面　圈", "line_no": 5, "char_start": 0, "char_end": 10}, "flags": [], "cross_blocks": null, "canon_version": "v1.0-ocr", "engine": "vision-python-v1", "yin": null}
{"type": "verse", "doc_id": "buyi_epic_12204413", "page": 236, "verse_no": 4, "layout": "xuanyi", "yi": {"text": "母猪有十二只奶，", "line_no": 6, "char_start": 8, "char_end": 16}, "zhi": {"text": "母猪　十二　奶", "line_no": 6, "char_start": 0, "char_end": 7}, "flags": [], "cross_blocks": null, "canon_version": "v1.0-ocr", "engine": "vision-python-v1", "yin": null}
