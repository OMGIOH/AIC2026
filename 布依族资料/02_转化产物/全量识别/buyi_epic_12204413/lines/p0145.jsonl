{"type": "verse", "doc_id": "buyi_epic_12204413", "page": 145, "verse_no": 1, "layout": "interlinear", "yi": {"text": "无人继管田塘。", "line_no": 3, "char_start": 12, "char_end": 19}, "zhi": {"text": "没有　人　接　池塘　田", "line_no": 3, "char_start": 0, "char_end": 11}, "flags": [], "cross_blocks": null, "canon_version": "v1.0-ocr", "engine": "vision-python-v1", "yin": {"text": "米　甫　继塘　帮", "line_no": 1, "char_start": 0, "char_end": 8}, "yin_line_consumed": true}
{"type": "verse", "doc_id": "buyi_epic_12204413", "page": 145, "verse_no": 2, "layout": "interlinear", "yi": {"text": "世间人已死光，", "line_no": 5, "char_start": 10, "char_end": 17}, "zhi": {"text": "全　地方真　死　坏", "line_no": 5, "char_start": 0, "char_end": 9}, "flags": [], "cross_blocks": null, "canon_version": "v1.0-ocr", "engine": "vision-python-v1", "yin": {"text": "了庞兴　殆　压", "line_no": 4, "char_start": 0, "char_end": 7}, "yin_line_consumed": true}
{"type": "verse", "doc_id": "buyi_epic_12204413", "page": 145, "verse_no": 3, "layout": "interlinear", "yi": {"text": "现在咱们管田塘，", "line_no": 7, "char_start": 12, "char_end": 20}, "zhi": {"text": "池塘　田　落　我们　管", "line_no": 7, "char_start": 0, "char_end": 11}, "flags": [], "cross_blocks": null, "canon_version": "v1.0-ocr", "engine": "vision-python-v1", "yin": {"text": "塘　帮　托　柔　管", "line_no": 6, "char_start": 0, "char_end": 9}, "yin_line_consumed": true}
{"type": "verse", "doc_id": "buyi_epic_12204413", "page": 145, "verse_no": 4, "layout": "interlinear", "yi": {"text": "不用绕弯话，", "line_no": 9, "char_start": 10, "char_end": 16}, "zhi": {"text": "莫　用　做　心　弯", "line_no": 9, "char_start": 0, "char_end": 9}, "flags": [], "cross_blocks": null, "canon_version": "v1.0-ocr", "engine": "vision-python-v1", "yin": {"text": "改　用故仍　勾", "line_no": 8, "char_start": 0, "char_end": 7}, "yin_line_consumed": true}
{"type": "verse", "doc_id": "buyi_epic_12204413", "page": 145, "verse_no": 5, "layout": "interlinear", "yi": {"text": "我说你就准备。", "line_no": 11, "char_start": 10, "char_end": 17}, "zhi": {"text": "我　说　你　就　算", "line_no": 11, "char_start": 0, "char_end": 9}, "flags": [], "cross_blocks": null, "canon_version": "v1.0-ocr", "engine": "vision-python-v1", "yin": {"text": "姑　呶忙　吉　算", "line_no": 10, "char_start": 0, "char_end": 8}, "yin_line_consumed": true}
