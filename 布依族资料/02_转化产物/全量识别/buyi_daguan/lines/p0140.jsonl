{"type": "line", "doc_id": "buyi_daguan", "page": 140, "line_no": 2, "text": "鲍更嫡似乎不属于人鬼系统，而是由自然崇拜对象演变而来，是一种抽象理念的人格化。", "bbox_px": {"x": 88, "y": 282, "w": 1536, "h": 48}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "鲍更嫡似乎不属于人鬼系统，而是由自然崇拜对象演变而来，是一种抽象理念的人格化。", "conf": 1.0, "bbox_px": {"x": 88, "y": 282, "w": 1536, "h": 48}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
