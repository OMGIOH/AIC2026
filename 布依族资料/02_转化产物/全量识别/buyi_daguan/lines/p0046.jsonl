{"type": "line", "doc_id": "buyi_daguan", "page": 46, "line_no": 31, "text": "神话、古歌和传说。", "bbox_px": {"x": 92, "y": 2156, "w": 334, "h": 53}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "神话、古歌和传说。", "conf": 1.0, "bbox_px": {"x": 92, "y": 2156, "w": 334, "h": 53}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
