{"type": "line", "doc_id": "buyi_daguan", "page": 477, "line_no": 7, "text": "下设文化、经济、历史等研究小组。学会成立后组织会员对布依族的民风民俗、历史状", "bbox_px": {"x": 129, "y": 551, "w": 1540, "h": 48}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "下设文化、经济、历史等研究小组。学会成立后组织会员对布依族的民风民俗、历史状", "conf": 1.0, "bbox_px": {"x": 129, "y": 551, "w": 1540, "h": 48}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
