{"type": "line", "doc_id": "buyi_daguan", "page": 152, "line_no": 27, "text": "间并无多少区别，但是从居住到环境却更舒适更气派更美了。", "bbox_px": {"x": 109, "y": 1754, "w": 1069, "h": 56}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "间并无多少区别，但是从居住到环境却更舒适更气派更美了。", "conf": 1.0, "bbox_px": {"x": 109, "y": 1754, "w": 1069, "h": 56}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
{"type": "line", "doc_id": "buyi_daguan", "page": 152, "line_no": 28, "text": "请师、祭棺、开丧等仪式均在第一天举行。", "bbox_px": {"x": 189, "y": 1819, "w": 724, "h": 56}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "请师、祭棺、开丧等仪式均在第一天举行。", "conf": 1.0, "bbox_px": {"x": 189, "y": 1819, "w": 724, "h": 56}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
