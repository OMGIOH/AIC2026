{"type": "line", "doc_id": "buyi_daguan", "page": 62, "line_no": 38, "text": "季农忙到来之前过大年。大年称“根香”［kun'", "bbox_px": {"x": 72, "y": 2341, "w": 829, "h": 61}, "n_blocks": 1, "min_conf": 0.5, "blocks": [{"text": "季农忙到来之前过大年。大年称“根香”［kun'", "conf": 0.5, "bbox_px": {"x": 72, "y": 2341, "w": 829, "h": 61}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
