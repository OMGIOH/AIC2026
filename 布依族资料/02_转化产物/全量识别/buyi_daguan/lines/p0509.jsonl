{"type": "line", "doc_id": "buyi_daguan", "page": 509, "line_no": 24, "text": "卷。", "bbox_px": {"x": 165, "y": 1662, "w": 68, "h": 52}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "卷。", "conf": 1.0, "bbox_px": {"x": 165, "y": 1662, "w": 68, "h": 52}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
