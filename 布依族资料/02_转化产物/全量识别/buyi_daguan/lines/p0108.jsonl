{"type": "line", "doc_id": "buyi_daguan", "page": 108, "line_no": 13, "text": "地面无人烟。", "bbox_px": {"x": 414, "y": 925, "w": 229, "h": 49}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "地面无人烟。", "conf": 1.0, "bbox_px": {"x": 414, "y": 925, "w": 229, "h": 49}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
