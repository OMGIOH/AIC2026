{"type": "line", "doc_id": "buyi_daguan", "page": 435, "line_no": 28, "text": "把门钉好后随即开财门，一人在外，一人在内，一问一答。", "bbox_px": {"x": 221, "y": 1919, "w": 985, "h": 52}, "n_blocks": 1, "min_conf": 0.5, "blocks": [{"text": "把门钉好后随即开财门，一人在外，一人在内，一问一答。", "conf": 0.5, "bbox_px": {"x": 221, "y": 1919, "w": 985, "h": 52}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
