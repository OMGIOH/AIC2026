{"type": "line", "doc_id": "buyi_daguan", "page": 217, "line_no": 25, "text": "可运载较多物品。但是木筏", "bbox_px": {"x": 121, "y": 1738, "w": 486, "h": 48}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "可运载较多物品。但是木筏", "conf": 1.0, "bbox_px": {"x": 121, "y": 1738, "w": 486, "h": 48}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
