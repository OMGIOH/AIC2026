{"type": "verse", "doc_id": "buyi_epic_12204413", "page": 30, "verse_no": 3, "layout": "interlinear", "yi": {"text": "干活没得吃，", "line_no": 6, "char_start": 7, "char_end": 13}, "zhi": {"text": "做活　得　吃", "line_no": 6, "char_start": 0, "char_end": 6}, "flags": [], "cross_blocks": null, "canon_version": "v1.0-ocr", "engine": "vision-python-v1", "yin": {"text": "故洪　否　唻　哏", "line_no": 5, "char_start": 0, "char_end": 8}, "yin_line_consumed": true}
{"type": "verse", "doc_id": "buyi_epic_12204413", "page": 30, "verse_no": 4, "layout": "interlinear", "yi": {"text": "人们生怨气。", "line_no": 9, "char_start": 10, "char_end": 16}, "zhi": {"text": "人　咱们　真　生气", "line_no": 9, "char_start": 0, "char_end": 9}, "flags": [], "cross_blocks": null, "canon_version": "v1.0-ocr", "engine": "vision-python-v1", "yin": {"text": "文　柔　兴　利压 创天", "line_no": 7, "char_start": 0, "char_end": 11}, "yin_line_consumed": true}
{"type": "verse", "doc_id": "buyi_epic_12204413", "page": 30, "verse_no": 5, "layout": "interlinear", "yi": {"text": "整个世界全干旱，", "line_no": 11, "char_start": 9, "char_end": 17}, "zhi": {"text": "做　旱　全　天下", "line_no": 11, "char_start": 0, "char_end": 8}, "flags": [], "cross_blocks": null, "canon_version": "v1.0-ocr", "engine": "vision-python-v1", "yin": {"text": "故　然　了　天哈　人遊", "line_no": 10, "char_start": 0, "char_end": 11}, "yin_line_consumed": true}
