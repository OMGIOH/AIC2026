{"type": "line", "doc_id": "buyi_daguan", "page": 385, "line_no": 18, "text": "刷把舞，布依语称“敬纠碧”或“得碧舞”。此舞分大、小刷把舞两种。", "bbox_px": {"x": 209, "y": 1191, "w": 1186, "h": 60}, "n_blocks": 1, "min_conf": 0.5, "blocks": [{"text": "刷把舞，布依语称“敬纠碧”或“得碧舞”。此舞分大、小刷把舞两种。", "conf": 0.5, "bbox_px": {"x": 209, "y": 1191, "w": 1186, "h": 60}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
