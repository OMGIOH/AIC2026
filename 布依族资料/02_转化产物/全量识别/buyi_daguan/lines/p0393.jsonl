{"type": "line", "doc_id": "buyi_daguan", "page": 393, "line_no": 15, "text": "诸神中的核心人物是“生殖图”中的万岁天尊圣母，即布依族普遍信仰的“花王圣", "bbox_px": {"x": 205, "y": 1074, "w": 1459, "h": 57}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "诸神中的核心人物是“生殖图”中的万岁天尊圣母，即布依族普遍信仰的“花王圣", "conf": 1.0, "bbox_px": {"x": 205, "y": 1074, "w": 1459, "h": 57}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
{"type": "line", "doc_id": "buyi_daguan", "page": 393, "line_no": 16, "text": "母”，又叫“花婆”", "bbox_px": {"x": 125, "y": 1139, "w": 306, "h": 56}, "n_blocks": 1, "min_conf": 0.5, "blocks": [{"text": "母”，又叫“花婆”", "conf": 0.5, "bbox_px": {"x": 125, "y": 1139, "w": 306, "h": 56}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
