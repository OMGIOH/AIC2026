{"type": "line", "doc_id": "buyi_daguan", "page": 435, "line_no": 24, "text": "“手提斧头白如银，", "bbox_px": {"x": 458, "y": 1656, "w": 343, "h": 54}, "n_blocks": 1, "min_conf": 1.0, "blocks": [{"text": "“手提斧头白如银，", "conf": 1.0, "bbox_px": {"x": 458, "y": 1656, "w": 343, "h": 54}}], "canon_version": "v1.1-ocr", "engine": "vision-python-v1"}
